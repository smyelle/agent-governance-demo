# Google Cloud Project & Region (replace <PROJECT_ID> in your local .env)
GOOGLE_CLOUD_PROJECT=<PROJECT_ID>
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_GENAI_API_TRANSPORT=rest
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true

# Long-Term Availability Gemini Flash Model
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LITE_MODEL=gemini-3.5-flash-lite

# Architecture Mode: enterprise_hybrid (Default 4-Tier A-La-Carte Coexistence) | google_native (Full GCP Paved Path)
CYMBAL_PLATFORM_MODE=enterprise_hybrid

# Governance & Storage Resources
CYMBAL_STAGING_BUCKET=gs://<PROJECT_ID>-us-central1
CYMBAL_BQ_DATASET=cymbal_governance
CYMBAL_FIRESTORE_DATABASE=(default)
CYMBAL_MODEL_ARMOR_LOW_TEMPLATE=projects/<PROJECT_ID>/locations/us-central1/templates/cymbal-low-baseline-gpp
CYMBAL_MODEL_ARMOR_DEFAULT_TEMPLATE=projects/<PROJECT_ID>/locations/us-central1/templates/cymbal-default-medium-gpp
CYMBAL_MODEL_ARMOR_STRICT_TEMPLATE=projects/<PROJECT_ID>/locations/us-central1/templates/cymbal-strict-ag3-gpp

# Cloud Run Downstream & Web UI Endpoints (populated by infra/02_deploy_services.sh & infra/05_deploy_web_ui.sh)
CYMBAL_MCP_URL=https://cymbal-ops-mcp-server.run.app/mcp
CYMBAL_A2A_URL=https://remediation-a2a-agent.run.app
CYMBAL_WEB_UI_URL=https://cymbal-ops-release-web.run.app

# Optional Hybrid Bridge Endpoints (illustrative placeholders; override in .env)
HYBRID_GATEWAY_BASE_URL=https://ai-gateway.cymbal.example/v1
HYBRID_OTLP_ENDPOINT=
