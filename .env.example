# Google Cloud Project & Region (replace <PROJECT_ID> in your local .env)
GOOGLE_CLOUD_PROJECT=<PROJECT_ID>
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_GENAI_API_TRANSPORT=rest
GOOGLE_CLOUD_AGENT_ENGINE_ENABLE_TELEMETRY=true

# Long-Term Availability Gemini Flash Model
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LITE_MODEL=gemini-3.5-flash-lite

# Architecture Mode: google_native | comcast_hybrid
SCAPE_MODE=google_native

# Governance & Storage Resources
SCAPE_STAGING_BUCKET=gs://<PROJECT_ID>-us-central1
SCAPE_BQ_DATASET=scape_governance
SCAPE_FIRESTORE_DATABASE=(default)
SCAPE_MODEL_ARMOR_DEFAULT_TEMPLATE=projects/<PROJECT_ID>/locations/us-central1/templates/scape-default-medium-gpp
SCAPE_MODEL_ARMOR_STRICT_TEMPLATE=projects/<PROJECT_ID>/locations/us-central1/templates/scape-strict-ag3-gpp

# Cloud Run Downstream Endpoints (populated by infra/02_deploy_services.sh)
SCAPE_MCP_URL=https://devx-mcp-server.run.app/mcp
SCAPE_A2A_URL=https://remediation-a2a-agent.run.app

# Optional Hybrid Bridge Endpoints (illustrative placeholders; override in .env)
FLOW_VMG_BASE_URL=https://flow-gateway.enterprise.example/v1
LANGFUSE_OTLP_ENDPOINT=
