# Local execution blueprint & reference archives (NEVER commit)
PLAN.md
*.zip
scape_docs*
docs/
*.internal.md

# Environment & local tenant overrides (NEVER commit)
.env
.env.*
!.env.example
*.local.yaml
*.local.yml
*.local.json
config/tenant_profile.local.yaml
infra/.runtime_state.env
infra/manifests/.rendered/

# Python virtual environments, caches & build artifacts
.venv/
venv/
ENV/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Compiled / serialized / archive artifacts (NEVER commit)
*.pkl
*.pickle
*.tar.gz
*.tgz
*.whl
*.jar
*.so
*.dylib

# Credentials & keys (safety net)
*credentials*.json
*service-account*.json
*.pem
*.key
jwt_secret.txt

# OS & editor files
.DS_Store
.AppleDouble
.LSOverride
.idea/
.vscode/
*.swp
*~
